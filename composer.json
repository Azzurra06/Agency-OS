{
    "name": "azzurra06/agency-os",
    "description": "Agency OS — SaaS de pilotage stratégique et financier pour agences digitales (MVP portfolio).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-sodium": "Requis sur l'hébergement commercial (XChaCha20-Poly1305, Argon2id)",
        "ext-intl": "Formatage localisé"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": { "php": "8.3.0" },
        "audit": { "abandoned": "report" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": ["@php tools/check-forbidden.php", "@analyse", "@test"]
    }
}
