# Agency OS — configuration (copier en config/.env, droits 600, hors du répertoire public, jamais dans Git)
# « [prod] » : obligatoire en production.

# --- Application ---
APP_ENV=production                 # production | development | testing
APP_PROFILE=portfolio              # portfolio (données fictives) | production (SaaS commercial)
APP_REAL_DATA_ALLOWED=false        # true interdit en portfolio ; en production, après la checklist « données réelles »
APP_URL=https://agency-os.azzurra-pro.com
APP_KEY=                           # [prod] 64 caractères hexadécimaux aléatoires : php bin/generate-key.php --app-key
APP_TIMEZONE=Europe/Paris

# --- Base de données (connexion locale : 127.0.0.1, jamais l'hôte distant) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Sessions ---
SESSION_SECURE=true                # false uniquement en développement local sans HTTPS
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# --- Chiffrement des champs sensibles ---
CRYPTO_PROVIDER=openssl            # openssl (portfolio, décision S2) | sodium (SaaS commercial)
KEYS_PATH=                         # vide = config/keys

# --- Emails ---
MAIL_TRANSPORT=capture             # capture (aucun envoi) | null | smtp (interdit en portfolio)
MAIL_FROM=no-reply@azzurra-pro.com
MAIL_ALLOWLIST=                    # ex. @azzurra-pro.com (vide = pas de restriction)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- Mentions légales (pages /mentions-legales et /confidentialite) ---
# À renseigner sur le serveur uniquement (jamais dans le dépôt). Sans éditeur ni contact, les pages affichent « à compléter ».
LEGAL_PUBLISHER=                   # nom de l'éditrice ou de l'éditeur du site
LEGAL_CONTACT_EMAIL=               # adresse de contact (exercice des droits RGPD)
LEGAL_ADDRESS=                     # adresse postale (facultatif selon le statut)
LEGAL_REGISTRATION=                # SIRET / RCS le cas échéant (facultatif)

